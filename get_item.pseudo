# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

    GIVEN current_room
    GIVEN room_inventory
    GIVEN player_inventory

    OUTPUT "What will you do?"
    INPUT player_command
    SET requested_item = get item name from player_command

    IF current_room has an item AND requested_item = room_inventory[current_room]
        ADD requested_item TO player_inventory
        REMOVE requested_item FROM room_inventory
        OUTPUT "You acquired" + requested_item + "and added it to your inventory."

    ELSE 
        OUTPUT "There is no" + requested_item + "in this room."

    END IF

# Paycheck Calculator Pseudocode Template
#
# Replace every TODO prompt with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Your finished pseudocode should represent the same logic as your flowchart.
# Use clear indentation and ALLCAPS pseudocode keywords, such as GET (input),
# PUT (output), LET (assignment), IF, ELSE, and ENDIF where they fit your design.

START paycheck_calculator


SET reg_rate to 20
SET ot_rate to 30
REPEAT
    INPUT Hours_Worked
    IF Hours_Worked <= 0 THEN
        DISPLAY "Invalid Entry. Please Try Again"
        GO BACK to the start of the loop
    ENDIF
    
    DISPLAY "You worked" + Hours_Worked + "Hours. Is that correct? Yes or No."
    INPUT confirmation
    IF confirmation = "Yes" THEN
        EXIT loop
    ENDIF
    DISPLAY "Please Try Again."
    GO BACK to start of loop
END REPEAT

IF Hours <= 40 THEN
    SET total_pay  to Hours_Worked * reg_rate
ELSE
    SET reg_pay = 40 * reg_rate
    SET ot_pay = (Hours_Worked - 40) * ot_rate
    SET total_pay = reg_pay + ot_rate
ENDIF

DISPLAY "Your total pay is $" + total_pay


END paycheck_calculator



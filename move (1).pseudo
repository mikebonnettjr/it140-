# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

GIVEN current_room
GIVEN room_map
SET game_over = FALSE

OUTPUT "You are currently in" + current_room + "."
OUTPUT "What will you do?"
INPUT player_command
SET direction = get direction from player command


IF direction IS A VALID EXIT IN room_map[current_room] THEN
    SET current_room = room_map[current_room][direction]
    OUTPUT "You explore" + direction + "into" + current_room
ELSE   
    OUTPUT "There are no passages in that direction."
END IF

WHILE game_over = FALSE
    REPEAT steps 2 - 5 for each new player command
    IF current_room = "The Brood Mother's Lair" OR player_command = "exit" THEN 
        SET game_over = TRUE
    END IF
END WHILE



%room dictionary for main game%
rooms = {
    "The Entrance to the Temple of Akkala": {"south": "The Hall of Torches"},
    "The Hall of Torches": {"north": "The Entrance to the Temple of Akkala", "west": "The Temple Armory", "south": "The Shrine of Life", "east": "The Blast Hollow"},
    "The Temple Armory": {"east": "The Hall of Torches", "south": "The Webbed Crypt"},
    "The Webbed Crypt": {"north": "The Temple Armory"},
    "The Shrine of Life" : {"north": "The Hall of Torches", "south": "The Brood Mother's Lair"},
    "The Brood Mother's Lair": {"north": "The Shrine of Life"},
    "The Blast Hollow": {"west": "The Hall of Torches", "south": "The Hall of Valor", "east": "The Wanderer's Camp"},
    "The Wanderer's Camp": {"west": "The Blast Hollow", "north": "The Hidden Vault"},
    "The Hidden Vault": {"south": "The Wanderer's Camp"},
    "The Hall of Valor": {"north": "The Blast Hollow"},
 }   
